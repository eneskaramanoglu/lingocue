<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F4F5F7" />
          <SolidColorBrush x:Key="PanelBorderBrush" Color="#DADDE3" />
          <SolidColorBrush x:Key="VideoBackgroundBrush" Color="#101114" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280" />
          <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FDE8E8" />
          <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FEF3C7" />
          <SolidColorBrush x:Key="WarningForegroundBrush" Color="#B45309" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1E1F23" />
          <SolidColorBrush x:Key="PanelBorderBrush" Color="#33353B" />
          <SolidColorBrush x:Key="VideoBackgroundBrush" Color="#000000" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#9CA3AF" />
          <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#4A1D1D" />
          <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#4A3B12" />
          <SolidColorBrush x:Key="WarningForegroundBrush" Color="#FBBF24" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <FontFamily x:Key="MonoFont">Cascadia Mono, Menlo, Consolas, monospace</FontFamily>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style Selector="Border.video">
    <Setter Property="Background" Value="{DynamicResource VideoBackgroundBrush}" />
  </Style>

  <Style Selector="Border.error">
    <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="8,8,8,0" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style Selector="Button.transport">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Focusable" Value="False" />
  </Style>

  <Style Selector="Button.transport PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>

  <Style Selector="Button.play">
    <Setter Property="Padding" Value="12,6" />
  </Style>

  <!-- Cue table -->
  <Style Selector="Border.current">
    <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="Width" Value="4" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style Selector="Border.cpsHigh">
    <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
  </Style>

  <Style Selector="Border.cpsTooHigh">
    <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}" />
  </Style>

  <Style Selector="TextBlock.hasError">
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>

  <!-- Mark column: ● changed (accent), ! needs review (warning), ✕ LLM failed (error). -->
  <Style Selector="TextBlock.mark">
    <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="TextBlock.mark.review">
    <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
  </Style>

  <Style Selector="TextBlock.mark.failed">
    <Setter Property="Foreground" Value="{DynamicResource SystemErrorTextColor}" />
  </Style>

  <Style Selector="TextBlock.issues">
    <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TextBlock.placeholder">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
</Styles>
