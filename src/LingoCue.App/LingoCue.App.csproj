<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>LingoCue.App</RootNamespace>
    <AssemblyName>LingoCue</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\lingocue.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Also a plain file: FFmpeg draws the template gallery on it when the project has no video. -->
    <None Include="Assets/gallery-background.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="HanumanInstitute.LibMpv" />
    <PackageReference Include="HanumanInstitute.LibMpv.Avalonia" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <!-- libmpv for Windows: fetched (pinned + SHA256) by build/fetch-libmpv.ps1, never committed. -->
  <PropertyGroup>
    <LibMpvWinDir>$(MSBuildThisFileDirectory)..\..\build\native\win-x64\</LibMpvWinDir>
    <BundleLibMpvWin Condition="'$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT')">true</BundleLibMpvWin>
  </PropertyGroup>

  <Target Name="FetchLibMpv" BeforeTargets="AssignTargetPaths" Condition="'$(BundleLibMpvWin)' == 'true' And !Exists('$(LibMpvWinDir)libmpv-2.dll')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\build\fetch-libmpv.ps1&quot;" />
  </Target>

  <ItemGroup Condition="'$(BundleLibMpvWin)' == 'true'">
    <None Include="$(LibMpvWinDir)libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LingoCue.Core\LingoCue.Core.csproj" />
    <ProjectReference Include="..\LingoCue.Media\LingoCue.Media.csproj" />
    <ProjectReference Include="..\LingoCue.Transcription\LingoCue.Transcription.csproj" />
    <ProjectReference Include="..\LingoCue.Llm\LingoCue.Llm.csproj" />
    <ProjectReference Include="..\LingoCue.Infrastructure\LingoCue.Infrastructure.csproj" />
  </ItemGroup>

</Project>
