<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LingoCue.App.App"
             Name="LingoCue"
             RequestedThemeVariant="Default">
  <!-- "Default" follows the OS theme; the user can switch to Light/Dark from the toolbar. -->

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://LingoCue/Styles/Shell.axaml" />
  </Application.Styles>
</Application>
