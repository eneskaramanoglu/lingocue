<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LingoCue.App.ViewModels"
        xmlns:tr="using:LingoCue.Transcription"
        x:Class="LingoCue.App.Views.TranscribeDialog"
        x:DataType="vm:TranscribeDialogViewModel"
        Title="Transkribe Et"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <!-- Dialog layout used by all dialogs: icon header, body, footer bar with Vazgeç and the primary action. -->
  <DockPanel>
  <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="20,18,20,4">
    <Border Classes="dlgicon"><PathIcon Data="{StaticResource IconMic}" /></Border>
    <StackPanel Grid.Column="1" Spacing="2">
      <TextBlock Text="Transkribe et" Classes="h1" />
      <TextBlock Text="Konuşma kelime zamanlarıyla tanınır ve okunur satırlara bölünür; sonuç yeni bir “Kaynak” izi olur."
                 TextWrapping="Wrap" Classes="muted small" />
    </StackPanel>
  </Grid>
  <Border DockPanel.Dock="Bottom" Classes="dlgfooter">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Vazgeç" IsCancel="True" Click="OnCancel" MinWidth="90" />
      <Button Content="Başlat" Classes="accent" IsDefault="True" IsEnabled="{Binding CanStart}" Click="OnStart" MinWidth="90" />
    </StackPanel>
  </Border>
  <StackPanel Margin="20,12,20,18" Spacing="12">

    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
      <TextBlock Grid.Row="0" Text="Motor" VerticalAlignment="Center" />
      <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                ItemsSource="{Binding Engines}" SelectedItem="{Binding SelectedEngine}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="tr:ITranscriptionEngine">
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Grid.Row="1" Text="Model" VerticalAlignment="Center" />
      <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="tr:TranscriptionModel">
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Grid.Row="2" Text="Konuşma dili" VerticalAlignment="Center" />
      <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" />

      <!-- Mixed recording: tick the spoken languages (ItemsControl + WrapPanel lays the boxes out in rows). -->
      <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4" IsVisible="{Binding IsMixed}">
        <ItemsControl ItemsSource="{Binding MixedChoices}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MixedLanguageChoice">
              <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}" Margin="0,0,14,0" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding MixedHint}" TextWrapping="Wrap" Classes="muted small" />
      </StackPanel>

      <CheckBox Grid.Row="4" Grid.Column="1" Content="Konuşmacıları ayır (bulut)"
                IsChecked="{Binding Diarize}" IsEnabled="{Binding CanDiarize}" />
    </Grid>

    <TextBlock Text="{Binding ModelInfo}" TextWrapping="Wrap" Classes="muted" />

    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Classes="issues"
               IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <Border Classes="error" Margin="0" IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding Problem}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Remedy}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <StackPanel IsVisible="{Binding HasCachedRun}" Spacing="4">
      <CheckBox Content="Projedeki önceki sonucu kullan (ücretsiz, anında)" IsChecked="{Binding UseCache}" />
      <TextBlock Text="{Binding CachedRunText}" TextWrapping="Wrap" Classes="muted" />
    </StackPanel>

  </StackPanel>
  </DockPanel>
</Window>
