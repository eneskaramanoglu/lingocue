<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LingoCue.App.ViewModels"
        x:Class="LingoCue.App.Views.TracksDialog"
        x:DataType="vm:TracksViewModel"
        Title="İzler"
        Width="760" Height="460" MinWidth="560" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <!-- A list of tracks on the left, actions for the selected one on the right. -->
  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="Kapat" Classes="accent" IsDefault="True" IsCancel="True" Click="OnClose" MinWidth="90" />
      <TextBlock Text="{Binding Message}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
    </DockPanel>

    <StackPanel DockPanel.Dock="Right" Width="200" Spacing="6" Margin="12,0,0,0">
      <Button Content="Yukarı taşı" Command="{Binding MoveUpCommand}" HorizontalAlignment="Stretch" />
      <Button Content="Aşağı taşı" Command="{Binding MoveDownCommand}" HorizontalAlignment="Stretch" />
      <Button Content="Çoğalt" Command="{Binding DuplicateCommand}" HorizontalAlignment="Stretch" />
      <Button Content="Boş iz ekle" Command="{Binding AddEmptyCommand}" HorizontalAlignment="Stretch" />
      <Button Content="Zamanlamayı kaynaktan al" Command="{Binding SyncTimingCommand}" HorizontalAlignment="Stretch"
              ToolTip.Tip="Kaynak izde zamanlamayı düzelttiyseniz, bu izin satırlarına aynı başlangıç/bitiş zamanlarını kopyalar (metin değişmez)" />
      <Separator />
      <Button Content="Sil…" Command="{Binding DeleteCommand}" HorizontalAlignment="Stretch" />
      <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12"
                 Text="Sıra, dışa aktarmada izlerin sırasıdır. Ad ve dili listede düzenleyebilirsiniz." />
    </StackPanel>

    <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:TrackRowViewModel">
          <Grid ColumnDefinitions="*,90" RowDefinitions="Auto,Auto" ColumnSpacing="8" Margin="0,2">
            <TextBox Text="{Binding Name}" />
            <TextBox Grid.Column="1" Text="{Binding Language}" ToolTip.Tip="Dil kodu: tr, en, de…" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Details}" Classes="muted" Margin="2,4,0,0" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
