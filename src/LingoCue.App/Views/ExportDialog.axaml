<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LingoCue.App.ViewModels"
        xmlns:sub="using:LingoCue.Core.Subtitles"
        x:Class="LingoCue.App.Views.ExportDialog"
        x:DataType="vm:ExportDialogViewModel"
        Title="Dışa Aktar"
        Width="640" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <DockPanel>
  <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="20,18,20,4">
    <Border Classes="dlgicon"><PathIcon Data="{StaticResource IconDownload}" /></Border>
    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
      <TextBlock Text="Dışa aktar" Classes="h1" />
      <TextBlock Text="Ne üretmek istediğini seç." Classes="muted small" />
    </StackPanel>
  </Grid>
  <Border DockPanel.Dock="Bottom" Classes="dlgfooter">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Vazgeç" IsCancel="True" Click="OnCancel" MinWidth="90" />
      <Button Content="{Binding StartLabel}" Classes="accent" IsDefault="True" IsEnabled="{Binding CanStart}" Click="OnStart" MinWidth="110" />
    </StackPanel>
  </Border>

  <!-- Three kinds of export as choice cards; each shows only its own options below. -->
  <StackPanel Margin="20,12,20,18" Spacing="12">
    <UniformGrid Columns="2" ColumnSpacing="10" RowSpacing="10">
      <RadioButton Classes="choice" GroupName="kind" IsChecked="{Binding IsSubtitleFiles}">
        <StackPanel Spacing="6">
          <TextBlock Text="Altyazı dosyası" FontWeight="SemiBold" />
          <TextBlock Text="SRT, VTT, ASS. Premiere Pro veya YouTube için." Classes="muted small" TextWrapping="Wrap" />
        </StackPanel>
      </RadioButton>
      <RadioButton Classes="choice" GroupName="kind" IsChecked="{Binding IsBurnIn}" IsEnabled="{Binding CanBurnIn}">
        <StackPanel Spacing="6">
          <TextBlock Text="Videoya göm" FontWeight="SemiBold" />
          <TextBlock Text="Altyazı görüntünün parçası olur, önizlemedeki gibi. MP4." Classes="muted small" TextWrapping="Wrap" />
        </StackPanel>
      </RadioButton>
      <RadioButton Classes="choice" GroupName="kind" IsChecked="{Binding IsSoftSub}" IsEnabled="{Binding HasVideo}">
        <StackPanel Spacing="6">
          <TextBlock Text="Açılır-kapanır" FontWeight="SemiBold" />
          <TextBlock Text="Video yeniden kodlanmaz, hızlıdır. MP4 veya MKV." Classes="muted small" TextWrapping="Wrap" />
        </StackPanel>
      </RadioButton>
      <RadioButton Classes="choice" GroupName="kind" IsChecked="{Binding IsOverlay}" IsEnabled="{Binding CanBurnIn}">
        <StackPanel Spacing="6">
          <TextBlock Text="Altyazı katmanı" FontWeight="SemiBold" />
          <TextBlock Text="Saydam video, Premiere / Resolve'da üst ize. Görüntü kalitesine dokunmaz. MOV." Classes="muted small" TextWrapping="Wrap" />
        </StackPanel>
      </RadioButton>
    </UniformGrid>

    <TextBlock Text="{Binding BurnInProblem}" Classes="issues" TextWrapping="Wrap"
               IsVisible="{Binding BurnInProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <!-- Track list for subtitle files and soft subtitles -->
    <StackPanel Spacing="6" IsVisible="{Binding ShowsTrackList}">
      <TextBlock Text="İZLER" Classes="section" />
      <ItemsControl ItemsSource="{Binding Tracks}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TrackChoice">
            <!-- A TextBlock, not a string Content: track names like "large-v3-q5_0" would lose "_" as an access key. -->
            <CheckBox IsChecked="{Binding IsSelected}"><TextBlock Text="{Binding Label}" /></CheckBox>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <CheckBox IsChecked="{Binding SplitByLanguage}" IsVisible="{Binding HasMixedTrack}"
                ToolTip.Tip="Örnek: film.tr.srt, film.en.srt, film.ko.srt; video dışa aktarmada her dil ayrı altyazı akışı olur">
        <TextBlock Text="Karışık dilli izi dile göre ayrı dosyalara böl" />
      </CheckBox>
    </StackPanel>

    <!-- Subtitle files -->
    <StackPanel Spacing="8" IsVisible="{Binding IsSubtitleFiles}">
      <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SubtitleFormatChoice">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <CheckBox Content="Premiere Pro uyumlu (UTF-8 BOM)" IsChecked="{Binding PremiereBom}" IsVisible="{Binding IsSrt}" />
      <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding IsSrt}"
                 Text="Premiere Pro: Dosya → İçe Aktar ile SRT'yi seçin, zaman çizelgesine sürükleyin. Stil Premiere'de verilir; SRT yalnızca metin ve zaman taşır. Birden çok iz seçerseniz her biri ayrı dosyaya yazılır." />
    </StackPanel>

    <!-- Burn-in -->
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8" IsVisible="{Binding IsBurnIn}">
      <TextBlock Text="İz" VerticalAlignment="Center" />
      <TextBlock Grid.Row="1" Text="Biçim" VerticalAlignment="Center" />
      <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding VideoFormats}" SelectedItem="{Binding SelectedVideoFormat}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:VideoFormatChoice">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FormatNote}" Classes="muted" TextWrapping="Wrap"
                 IsVisible="{Binding FormatNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding AllTracks}" SelectedItem="{Binding BurnTrack}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="sub:SubtitleTrack">
            <TextBlock>
              <Run Text="{Binding Name, Mode=OneWay}" />
              <Run Text="{Binding Language, StringFormat=' · {0}', Mode=OneWay}" Foreground="{DynamicResource MutedTextBrush}" />
            </TextBlock>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Grid.Row="3" Text="Kodlayıcı" VerticalAlignment="Center" IsVisible="{Binding UsesEncoder}" />
      <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Encoders}" SelectedItem="{Binding SelectedEncoder}" HorizontalAlignment="Stretch"
                IsVisible="{Binding UsesEncoder}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:EncoderChoice">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding EncoderNote}" Classes="issues" TextWrapping="Wrap"
                 IsVisible="{Binding EncoderNote, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <TextBlock Grid.Row="5" Text="Kalite" VerticalAlignment="Center" IsVisible="{Binding UsesQuality}" />
      <DockPanel Grid.Row="5" Grid.Column="1" IsVisible="{Binding UsesQuality}">
        <TextBlock DockPanel.Dock="Right" Text="{Binding QualityText}" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="200" />
        <!-- Slider runs from small file (left) to high quality (right): CRF is inverted. -->
        <Slider Minimum="-26" Maximum="-16" Value="{Binding Quality, Converter={x:Static vm:NegateConverter.Instance}}"
                TickFrequency="1" IsSnapToTickEnabled="True" />
      </DockPanel>
    </Grid>
    <TextBlock Text="{Binding BilingualNote}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding IsBurnIn}" />

    <!-- Overlay: one track (with its plan or bilingual partner) drawn on a transparent canvas. -->
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8" IsVisible="{Binding IsOverlay}">
      <TextBlock Text="İz" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding AllTracks}" SelectedItem="{Binding BurnTrack}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="sub:SubtitleTrack">
            <TextBlock>
              <Run Text="{Binding Name, Mode=OneWay}" />
              <Run Text="{Binding Language, StringFormat=' · {0}', Mode=OneWay}" Foreground="{DynamicResource MutedTextBrush}" />
            </TextBlock>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Grid.Row="1" Text="Kodek" VerticalAlignment="Center" />
      <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding OverlayCodecs}" SelectedItem="{Binding SelectedOverlayCodec}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:OverlayCodecChoice">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="muted" TextWrapping="Wrap"
                 Text="Premiere Pro: MOV'u içe aktarın ve videonun üstündeki V2 izine, 00:00'a koyun. Katman videoyla aynı boyutta, kare hızında ve uzunlukta; arka planı saydam. Son dışa aktarmayı Premiere tek seferde yapar, görüntü yeniden kodlanmaz. Altyazıyı düzeltirseniz yalnızca katmanı yeniden üretin." />
    </Grid>

    <!-- Soft subtitles -->
    <StackPanel Spacing="6" IsVisible="{Binding IsSoftSub}">
      <RadioButton GroupName="container" IsChecked="{Binding !UseMkv}"
                   Content="MP4 — her oynatıcıda ve telefonda çalışır; stil taşımaz" />
      <RadioButton GroupName="container" IsChecked="{Binding UseMkv}"
                   Content="MKV — stil, karaoke ve fontlar korunur (VLC, mpv, IINA)" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="İlk seçilen iz varsayılan olarak açık gelir." />
    </StackPanel>

    <Border Classes="error" Margin="0" IsVisible="{Binding StyleWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding StyleWarning}" TextWrapping="Wrap" />
    </Border>

  </StackPanel>
  </DockPanel>
</Window>
