<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LingoCue.App.ViewModels"
             xmlns:views="using:LingoCue.App.Views"
             xmlns:proj="using:LingoCue.Core.Projects"
             xmlns:sub="using:LingoCue.Core.Subtitles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="900"
             x:Class="LingoCue.App.Views.StyleEditorView"
             x:DataType="vm:StyleEditorViewModel">

  <!-- Sections are expanders drawn as cards; field labels are muted so the values stand out. -->
  <UserControl.Styles>
    <Style Selector="Expander">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource SunkenBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Expander Grid > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Expander Grid > TextBlock.issues">
      <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="Background" Value="{DynamicResource SunkenBackgroundBrush}" />
    </Style>
    <!-- Template cards: the thumbnail fills the top, an accent edge marks the applied template. -->
    <Style Selector="Button.template">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <!-- On the template part: Fluent's hover and pressed states set the border there and would hide the mark. -->
    <Style Selector="Button.template.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- Every control writes straight to the project; the video preview (libass) shows the result. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="12,10,12,16" Spacing="10" IsEnabled="{Binding HasProject}">

      <!-- Templates -->
      <StackPanel Spacing="6">
        <TextBlock Text="ŞABLONLAR" Classes="section" />
        <TextBlock Classes="muted small" TextWrapping="Wrap"
                   Text="Her kart, şablonun bu videodaki görünümüdür. Tıklayınca uygulanır; Ctrl+Z ile geri alabilirsiniz." />
        <!-- Gallery: thumbnails are rendered by libass through FFmpeg, like the preview and the export. -->
        <ItemsControl ItemsSource="{Binding Gallery}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TemplateCard">
              <Button Classes="template" Classes.selected="{Binding IsSelected}" Width="176" Padding="0"
                      Command="{Binding $parent[ItemsControl].((vm:StyleEditorViewModel)DataContext).ApplyCardCommand}"
                      CommandParameter="{Binding}" ToolTip.Tip="{Binding Name}">
                <StackPanel>
                  <Panel Height="99" Background="{DynamicResource SunkenBackgroundBrush}">
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                    <TextBlock Text="Önizleme hazırlanıyor…" Classes="muted small" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding !HasThumbnail}" />
                  </Panel>
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="10,7">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                    <TextBlock Text="· hazır" Classes="muted small" VerticalAlignment="Center" IsVisible="{Binding BuiltIn}" />
                  </StackPanel>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <WrapPanel ItemSpacing="6" LineSpacing="6">
          <Button Classes="small" Content="Şablon olarak kaydet…" Command="{Binding SaveTemplateCommand}"
                  ToolTip.Tip="Şu anki görünümü tüm projelerde kullanmak üzere kaydet" />
          <Button Classes="small" Content="İçe aktar…" Command="{Binding ImportTemplateCommand}" />
          <Button Classes="small" Content="Dışa aktar…" Command="{Binding ExportTemplateCommand}" />
          <Button Classes="small danger" Content="Sil" Command="{Binding DeleteTemplateCommand}" ToolTip.Tip="Yalnızca kendi şablonlarınız silinebilir" />
        </WrapPanel>
      </StackPanel>

      <!-- Text -->
      <Expander Header="Yazı" IsExpanded="True" HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
          <TextBlock Text="Font" VerticalAlignment="Center" />
          <DockPanel Grid.Column="1">
            <Button DockPanel.Dock="Right" Classes="small" Content="Font dosyası ekle…" Command="{Binding AddFontCommand}" Margin="6,0,0,0"
                    ToolTip.Tip="TTF/OTF dosyasını projenin yanındaki fonts klasörüne kopyalar; önizleme ve video bu fontu kullanır, proje başka bilgisayara taşındığında da çalışır" />
            <AutoCompleteBox ItemsSource="{Binding Fonts}" Text="{Binding FontName}" FilterMode="ContainsOrdinal"
                             MinimumPrefixLength="0" MaxDropDownHeight="320" />
          </DockPanel>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FontWarning}" TextWrapping="Wrap"
                     Classes.muted="{Binding !IsFontWarningSevere}" Classes.issues="{Binding IsFontWarningSevere}"
                     IsVisible="{Binding FontWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />

          <TextBlock Grid.Row="2" Text="Boyut" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding FontSize}" Minimum="8" Maximum="300" Increment="2" FormatString="0.#" />

          <WrapPanel Grid.Row="3" Grid.Column="1" ItemSpacing="12">
            <CheckBox Content="Kalın" IsChecked="{Binding Bold}" />
            <CheckBox Content="İtalik" IsChecked="{Binding Italic}" />
            <CheckBox Content="Altı çizili" IsChecked="{Binding Underline}" />
          </WrapPanel>

          <TextBlock Grid.Row="4" Text="Harf aralığı" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding Spacing}" Minimum="-10" Maximum="40" Increment="0.5" FormatString="0.#" />

          <CheckBox Grid.Row="5" Grid.Column="1" Content="BÜYÜK HARF (her satır kendi dilinin kurallarıyla: Türkçede i → İ)" IsChecked="{Binding UpperCase}" />
        </Grid>
      </Expander>

      <!-- Colors and border -->
      <Expander Header="Renk ve kenarlık" IsExpanded="True" HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
          <TextBlock Text="Yazı rengi" VerticalAlignment="Center" />
          <ColorPicker Grid.Column="1" Color="{Binding PrimaryColor}" HorizontalAlignment="Left" />

          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding OutlineInfo}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding OutlineInfo, Converter={x:Static ObjectConverters.IsNotNull}}" />

          <TextBlock Grid.Row="2" Text="Kontur kalınlığı" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Outline}" Minimum="0" Maximum="50" Increment="0.5" FormatString="0.#" />

          <TextBlock Grid.Row="3" Text="Kontur rengi" VerticalAlignment="Center" />
          <ColorPicker Grid.Row="3" Grid.Column="1" Color="{Binding OutlineColor}" HorizontalAlignment="Left" />

          <TextBlock Grid.Row="4" Text="Gölge" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding Shadow}" Minimum="0" Maximum="50" Increment="0.5" FormatString="0.#" />

          <TextBlock Grid.Row="5" Text="Gölge rengi" VerticalAlignment="Center" />
          <ColorPicker Grid.Row="5" Grid.Column="1" Color="{Binding ShadowColor}" HorizontalAlignment="Left" />
        </Grid>
      </Expander>

      <!-- Background box: drawn by libass in the preview and in burn-in alike (AssScriptBuilder). -->
      <Expander Header="Arka plan kutusu" IsExpanded="True" HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
          <TextBlock Text="Tür" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding BackgroundChoices}" SelectedItem="{Binding SelectedBackground}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:BackgroundChoice">
                <StackPanel Spacing="1">
                  <TextBlock Text="{Binding Label}" />
                  <TextBlock Text="{Binding Hint}" Classes="muted small" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Grid.Row="1" Text="Kutu rengi" VerticalAlignment="Center" IsVisible="{Binding HasBackground}" />
          <ColorPicker Grid.Row="1" Grid.Column="1" Color="{Binding BoxColor}" HorizontalAlignment="Left" IsVisible="{Binding HasBackground}"
                       ToolTip.Tip="Saydamlığı renk seçicinin alfa (A) değeriyle ayarlayın." />

          <TextBlock Grid.Row="2" Text="Yatay iç boşluk" VerticalAlignment="Center" IsVisible="{Binding HasSideBox}" />
          <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding BoxPaddingX}" Minimum="0" Maximum="400" Increment="2" FormatString="0" IsVisible="{Binding HasSideBox}" />

          <TextBlock Grid.Row="3" Text="Dikey iç boşluk" VerticalAlignment="Center" IsVisible="{Binding HasBackground}" />
          <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding BoxPaddingY}" Minimum="0" Maximum="400" Increment="2" FormatString="0" IsVisible="{Binding HasBackground}" />

          <TextBlock Grid.Row="4" Text="Çerçeve kalınlığı" VerticalAlignment="Center" IsVisible="{Binding HasBackground}" />
          <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding FrameWidth}" Minimum="0" Maximum="40" Increment="1" FormatString="0.#" IsVisible="{Binding HasBackground}" />

          <TextBlock Grid.Row="5" Text="Çerçeve rengi" VerticalAlignment="Center" IsVisible="{Binding HasFrame}" />
          <ColorPicker Grid.Row="5" Grid.Column="1" Color="{Binding FrameColor}" HorizontalAlignment="Left" IsVisible="{Binding HasFrame}" />

          <TextBlock Grid.Row="6" Text="Köşe yuvarlaklığı" VerticalAlignment="Center" IsVisible="{Binding HasBlockBox}" />
          <NumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding CornerRadius}" Minimum="0" Maximum="200" Increment="2" FormatString="0" IsVisible="{Binding HasBlockBox}"
                         ToolTip.Tip="0 = köşeli. Yuvarlak kutu yazının genişliği font dosyasından ölçülerek çizilir; ölçülemeyen ya da otomatik kaydırılacak kadar uzun satırlarda köşeli kutu kullanılır." />

          <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="{Binding BackgroundInfo}" Classes="muted" TextWrapping="Wrap"
                     IsVisible="{Binding BackgroundInfo, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Grid>
      </Expander>

      <!-- Position: a 3×3 grid laid out like the screen (numpad numbering of ASS). -->
      <Expander Header="Konum" IsExpanded="True" HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
          <TextBlock Text="Hizalama" VerticalAlignment="Top" Margin="0,6,0,0" />
          <UniformGrid Grid.Column="1" Columns="3" Rows="3" Width="132" HorizontalAlignment="Left">
            <RadioButton Classes="align" GroupName="align" Content="↖" ToolTip.Tip="Üst sol" IsChecked="{Binding Alignment, Converter={x:Static views:EqualsConverter.Instance}, ConverterParameter=7}" />
            <RadioButton Classes="align" GroupName="align" Content="↑" ToolTip.Tip="Üst orta" IsChecked="{Binding Alignment, Converter={x:Static views:EqualsConverter.Instance}, ConverterParameter=8}" />
            <RadioButton Classes="align" GroupName="align" Content="↗" ToolTip.Tip="Üst sağ" IsChecked="{Binding Alignment, Converter={x:Static views:EqualsConverter.Instance}, ConverterParameter=9}" />
            <RadioButton Classes="align" GroupName="align" Content="←" ToolTip.Tip="Orta sol" IsChecked="{Binding Alignment, Converter={x:Static views:EqualsConverter.Instance}, ConverterParameter=4}" />
            <RadioButton Classes="align" GroupName="align" Content="•" ToolTip.Tip="Tam orta" IsChecked="{Binding Alignment, Converter={x:Static views:EqualsConverter.Instance}, ConverterParameter=5}" />
            <RadioButton Classes="align" GroupName="align" Content="→" ToolTip.Tip="Orta sağ" IsChecked="{Binding Alignment, Converter={x:Static views:EqualsConverter.Instance}, ConverterParameter=6}" />
            <RadioButton Classes="align" GroupName="align" Content="↙" ToolTip.Tip="Alt sol" IsChecked="{Binding Alignment, Converter={x:Static views:EqualsConverter.Instance}, ConverterParameter=1}" />
            <RadioButton Classes="align" GroupName="align" Content="↓" ToolTip.Tip="Alt orta (en yaygın)" IsChecked="{Binding Alignment, Converter={x:Static views:EqualsConverter.Instance}, ConverterParameter=2}" />
            <RadioButton Classes="align" GroupName="align" Content="↘" ToolTip.Tip="Alt sağ" IsChecked="{Binding Alignment, Converter={x:Static views:EqualsConverter.Instance}, ConverterParameter=3}" />
          </UniformGrid>

          <TextBlock Grid.Row="1" Text="Alt/üst boşluk" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MarginV}" Minimum="0" Maximum="1500" Increment="5" FormatString="0" />

          <TextBlock Grid.Row="2" Text="Sol boşluk" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding MarginL}" Minimum="0" Maximum="1500" Increment="5" FormatString="0" />

          <TextBlock Grid.Row="3" Text="Sağ boşluk" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding MarginR}" Minimum="0" Maximum="1500" Increment="5" FormatString="0" />

          <CheckBox Grid.Row="4" Grid.Column="1" Content="Güvenli alan kılavuzlarını göster" IsChecked="{Binding ShowSafeArea}"
                    ToolTip.Tip="Beyaz: aksiyon güvenli alanı (%93), sarı: başlık güvenli alanı (%90). Yalnızca önizlemede görünür, videoya yazılmaz." />
        </Grid>
      </Expander>

      <!-- Effects -->
      <Expander Header="Efektler" HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
          <TextBlock Text="Belirme (ms)" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="1" Value="{Binding FadeIn}" Minimum="0" Maximum="5000" Increment="50" FormatString="0" />
          <TextBlock Grid.Row="1" Text="Kaybolma (ms)" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding FadeOut}" Minimum="0" Maximum="5000" Increment="50" FormatString="0" />
        </Grid>
      </Expander>

      <!-- Karaoke -->
      <Expander Header="Kelime kelime vurgulama (karaoke)" HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
          <TextBlock Text="Mod" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding KaraokeChoices}" SelectedItem="{Binding SelectedKaraoke}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:KaraokeChoice">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Grid.Row="1" Text="Vurgu rengi" VerticalAlignment="Center" />
          <ColorPicker Grid.Row="1" Grid.Column="1" Color="{Binding HighlightColor}" HorizontalAlignment="Left" IsEnabled="{Binding IsKaraokeOn}" />
          <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding KaraokeInfo}" Classes="muted" TextWrapping="Wrap" />
        </Grid>
      </Expander>

      <!-- Bilingual -->
      <Expander Header="İki dilli mod" HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
          <CheckBox Grid.ColumnSpan="2" Content="Seçili izin altında ikinci bir iz göster" IsChecked="{Binding BilingualEnabled}" />
          <!-- The second track's own font (e.g. one with Hangul for Korean). -->
          <TextBlock Grid.Row="6" Text="Font" VerticalAlignment="Center" />
          <AutoCompleteBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding Fonts}" Text="{Binding SecondaryFontName}" FilterMode="ContainsOrdinal"
                           MinimumPrefixLength="0" MaxDropDownHeight="320" />
          <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SecondaryFontWarning}" Classes="issues" TextWrapping="Wrap"
                     IsVisible="{Binding SecondaryFontWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Grid.Row="1" Text="İkinci iz" VerticalAlignment="Center" />
          <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SecondaryTracks}" SelectedItem="{Binding SecondaryTrack}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="sub:SubtitleTrack">
                <TextBlock>
                  <Run Text="{Binding Name, Mode=OneWay}" />
                  <Run Text="{Binding Language, StringFormat=' · {0}', Mode=OneWay}" Foreground="{DynamicResource MutedTextBrush}" />
                </TextBlock>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Grid.Row="2" Text="Boyut" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding SecondaryFontSize}" Minimum="8" Maximum="300" Increment="2" FormatString="0.#" />
          <TextBlock Grid.Row="3" Text="Renk" VerticalAlignment="Center" />
          <ColorPicker Grid.Row="3" Grid.Column="1" Color="{Binding SecondaryColor}" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="4" Text="Aradaki boşluk" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding Gap}" Minimum="0" Maximum="300" Increment="2" FormatString="0" />
          <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="{Binding BilingualInfo}" Classes="muted" TextWrapping="Wrap"
                     IsVisible="{Binding BilingualInfo, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Grid>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
