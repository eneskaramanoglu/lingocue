<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LingoCue.App.ViewModels"
        xmlns:mpv="using:HanumanInstitute.LibMpv.Avalonia"
        xmlns:sub="using:LingoCue.Core.Subtitles"
        xmlns:views="using:LingoCue.App.Views"
        xmlns:services="using:LingoCue.App.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="LingoCue.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/lingocue.ico"
        Title="{Binding Title}"
        Width="1200" Height="720" WindowState="Maximized"
        MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenVideoCommand}" />
    <KeyBinding Gesture="Meta+O" Command="{Binding OpenVideoCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveProjectCommand}" />
    <KeyBinding Gesture="Meta+S" Command="{Binding SaveProjectCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveProjectAsCommand}" />
    <KeyBinding Gesture="Meta+Shift+S" Command="{Binding SaveProjectAsCommand}" />
    <KeyBinding Gesture="Ctrl+I" Command="{Binding ImportSubtitleCommand}" />
    <KeyBinding Gesture="Meta+I" Command="{Binding ImportSubtitleCommand}" />
    <KeyBinding Gesture="Ctrl+T" Command="{Binding TranscribeCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportCommand}" />
    <KeyBinding Gesture="Ctrl+F" Command="{Binding Editor.OpenFindCommand}" />
    <KeyBinding Gesture="Meta+F" Command="{Binding Editor.OpenFindCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Meta+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Meta+Shift+Z" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Meta+E" Command="{Binding ExportCommand}" />
    <KeyBinding Gesture="Meta+T" Command="{Binding TranscribeCommand}" />
  </Window.KeyBindings>

  <DockPanel>

    <!-- App bar: logo + compact menu + document on the left, the Transkribe → Düzelt → Çevir workflow
         in the middle, undo/redo, settings and the one primary action (Dışa aktar) on the right. -->
    <Border DockPanel.Dock="Top" Classes="chrome" Height="52" BorderThickness="0,0,0,1" Padding="14,0,12,0">
     <Grid ColumnDefinitions="*,Auto,*">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource AccentBrush}">
          <PathIcon Data="{StaticResource IconLogo}" Width="15" Height="15" Foreground="{DynamicResource OnAccentBrush}" />
        </Border>
        <TextBlock Text="LingoCue" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
    <Menu Classes="appmenu" VerticalAlignment="Center">
      <MenuItem Header="_Dosya">
        <MenuItem Header="_Video Aç…" InputGesture="Ctrl+O" Command="{Binding OpenVideoCommand}" />
        <MenuItem Header="_Proje Aç…" Command="{Binding OpenProjectCommand}" />
        <!-- Each recent file becomes a submenu item; the style applies to the items, not to this menu. -->
        <MenuItem x:Name="RecentMenu" Header="_Son açılanlar" ItemsSource="{Binding RecentFiles}" IsEnabled="{Binding HasRecentFiles}">
          <MenuItem.Styles>
            <Style Selector="MenuItem#RecentMenu MenuItem" x:DataType="vm:RecentFileItem">
              <Setter Property="Header" Value="{Binding Header}" />
              <Setter Property="Command" Value="{Binding Open}" />
              <Setter Property="CommandParameter" Value="{Binding Path}" />
              <Setter Property="ToolTip.Tip" Value="{Binding Path}" />
            </Style>
          </MenuItem.Styles>
        </MenuItem>
        <Separator />
        <MenuItem Header="_Kaydet" InputGesture="Ctrl+S" Command="{Binding SaveProjectCommand}" />
        <MenuItem Header="_Farklı Kaydet…" InputGesture="Ctrl+Shift+S" Command="{Binding SaveProjectAsCommand}" />
        <Separator />
        <MenuItem Header="Altyazı _İçe Aktar…" InputGesture="Ctrl+I" Command="{Binding ImportSubtitleCommand}" />
        <MenuItem Header="_Dışa Aktar…" InputGesture="Ctrl+E" Command="{Binding ExportCommand}" />
      </MenuItem>
      <MenuItem Header="_Düzen">
        <MenuItem Header="_Geri al" InputGesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <MenuItem Header="_Yinele" InputGesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <Separator />
        <MenuItem Header="_Bul ve değiştir…" InputGesture="Ctrl+F" Command="{Binding Editor.OpenFindCommand}" />
        <Separator />
        <MenuItem Header="Yeni satır" InputGesture="Ctrl+Enter" Command="{Binding Editor.AddCueCommand}" />
        <MenuItem Header="Satırı _böl" InputGesture="Ctrl+B" Command="{Binding Editor.SplitCueCommand}" />
        <MenuItem Header="Sonrakiyle _birleştir" InputGesture="Ctrl+M" Command="{Binding Editor.MergeWithNextCommand}" />
        <Separator />
        <MenuItem Header="100 ms geri kaydır" InputGesture="Alt+Left" Command="{Binding Editor.NudgeBackCommand}" />
        <MenuItem Header="100 ms ileri kaydır" InputGesture="Alt+Right" Command="{Binding Editor.NudgeForwardCommand}" />
        <MenuItem Header="Başlangıcı oynatma konumuna al   [" Command="{Binding Editor.SetStartToPlayheadCommand}" />
        <MenuItem Header="Bitişi oynatma konumuna al   ]" Command="{Binding Editor.SetEndToPlayheadCommand}" />
      </MenuItem>
      <MenuItem Header="_Altyazı">
        <MenuItem Header="_Transkribe Et…" InputGesture="Ctrl+T" Command="{Binding TranscribeCommand}" />
        <MenuItem Header="_Düzelt…" Command="{Binding CorrectCommand}" />
        <MenuItem Header="Çe_vir…" Command="{Binding TranslateCommand}" />
        <MenuItem Header="Başarısız satırları _yeniden dene" Command="{Binding RetryFailedLinesCommand}"
                  ToolTip.Tip="Yapay zekânın yanıt vermediği satırları (✕) yeniden gönderir; biten satırlar tekrar ücretlendirilmez." />
        <Separator />
        <MenuItem Header="_İzler…" Command="{Binding ManageTracksCommand}" />
        <MenuItem Header="_Sözlük ve Bağlam…" Command="{Binding EditGlossaryCommand}" />
        <MenuItem Header="S_til" Command="{Binding ShowStyleCommand}" />
      </MenuItem>
      <MenuItem Header="A_yarlar">
        <MenuItem Header="_Tercihler…" InputGesture="Ctrl+OemComma" Command="{Binding PreferencesCommand}" />
        <MenuItem Header="Te_ma">
          <MenuItem Header="Sistem" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static services:AppTheme.System}" />
          <MenuItem Header="Açık" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static services:AppTheme.Light}" />
          <MenuItem Header="Koyu" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static services:AppTheme.Dark}" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Yardım">
        <MenuItem Header="_Kullanım kılavuzu" Command="{Binding OpenUserGuideCommand}" />
        <MenuItem Header="_Klavye kısayolları…" Click="OnShowShortcuts" />
        <Separator />
        <MenuItem Header="_Güncellemeleri denetle" Command="{Binding CheckForUpdatesCommand}" />
        <Separator />
        <MenuItem Header="_Tanılama paketi oluştur…" Command="{Binding CreateDiagnosticsCommand}" />
        <MenuItem Header="_Log klasörünü aç" Command="{Binding OpenLogFolderCommand}" />
        <MenuItem Header="_Hata bildir (GitHub)" Command="{Binding ReportIssueCommand}" />
        <Separator />
        <MenuItem Header="LingoCue _hakkında" Click="OnShowAbout" />
      </MenuItem>
    </Menu>
        <!-- Document name; the dot means unsaved changes. -->
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding HasProject}">
          <TextBlock Text="/" Classes="muted" VerticalAlignment="Center" />
          <TextBlock Text="{Binding DocumentName}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"
                     MaxWidth="260" TextTrimming="CharacterEllipsis" />
          <Ellipse Width="7" Height="7" Fill="{DynamicResource DirtyDotBrush}" IsVisible="{Binding IsDirty}"
                   VerticalAlignment="Center" ToolTip.Tip="Kaydedilmemiş değişiklik var" />
        </StackPanel>
      </StackPanel>

      <!-- Workflow: one connected group; a finished step shows a green check. -->
      <Border Grid.Column="1" Classes="workflow" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Classes="step" Command="{Binding TranscribeCommand}" Focusable="False"
                  ToolTip.Tip="Konuşmayı tanı ve altyazı oluştur (Ctrl+T / ⌘T)">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Panel>
                <PathIcon Data="{StaticResource IconMic}" Width="14" Height="14" IsVisible="{Binding !IsTranscribed}" />
                <PathIcon Data="{StaticResource IconCheck}" Width="14" Height="14" Classes="done" IsVisible="{Binding IsTranscribed}" />
              </Panel>
              <TextBlock Text="Transkribe" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <PathIcon Data="{StaticResource IconChevronRight}" Width="14" Height="14" Classes="joiner" />
          <Button Classes="step" Command="{Binding CorrectCommand}" Focusable="False"
                  ToolTip.Tip="Yapay zekâ ile tanıma hatalarını düzelt">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Panel>
                <PathIcon Data="{StaticResource IconWand}" Width="14" Height="14" IsVisible="{Binding !IsCorrected}" />
                <PathIcon Data="{StaticResource IconCheck}" Width="14" Height="14" Classes="done" IsVisible="{Binding IsCorrected}" />
              </Panel>
              <TextBlock Text="Düzelt" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <PathIcon Data="{StaticResource IconChevronRight}" Width="14" Height="14" Classes="joiner" />
          <Button Classes="step" Command="{Binding TranslateCommand}" Focusable="False"
                  ToolTip.Tip="Bir izi yapay zekâ ile başka dile çevirir (yeni iz, aynı zamanlama)">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Panel>
                <PathIcon Data="{StaticResource IconTranslate}" Width="14" Height="14" IsVisible="{Binding !IsTranslated}" />
                <PathIcon Data="{StaticResource IconCheck}" Width="14" Height="14" Classes="done" IsVisible="{Binding IsTranslated}" />
              </Panel>
              <TextBlock Text="Çevir" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Classes="icon" Command="{Binding UndoCommand}" Focusable="False" ToolTip.Tip="Geri al (Ctrl+Z / ⌘Z)">
          <PathIcon Data="{StaticResource IconUndo}" />
        </Button>
        <Button Classes="icon" Command="{Binding RedoCommand}" Focusable="False" ToolTip.Tip="Yinele (Ctrl+Y / ⌘⇧Z)">
          <PathIcon Data="{StaticResource IconRedo}" />
        </Button>
        <Button Classes="icon" Command="{Binding PreferencesCommand}" Focusable="False" ToolTip.Tip="Tercihler">
          <PathIcon Data="{StaticResource IconCog}" />
        </Button>
        <Button Classes="accent" Command="{Binding ExportCommand}" Focusable="False" Margin="4,0,0,0"
                ToolTip.Tip="Altyazı dosyası, altyazısı gömülü video veya açılıp kapanabilen altyazılı video (Ctrl/⌘+E)">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconDownload}" Width="15" Height="15" />
            <TextBlock Text="Dışa aktar" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
     </Grid>
    </Border>

    <!-- Status bar with progress + cancel for long-running jobs. -->
    <Border DockPanel.Dock="Bottom" Classes="chrome" Padding="14,4" BorderThickness="0,1,0,0" MinHeight="32">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10">
          <!-- Progress pill: a thin bar in a rounded accent tint while a job runs. -->
          <Border Classes="chip accent" Padding="10,0" Height="22" IsVisible="{Binding IsBusy}" VerticalAlignment="Center">
          <ProgressBar Width="110" MinWidth="0" Height="4" MinHeight="4" CornerRadius="2" Minimum="0" Maximum="1" Value="{Binding Progress}"
                       IsIndeterminate="{Binding IsProgressIndeterminate}" VerticalAlignment="Center" />
          </Border>
          <Button Classes="small" Content="İptal" Command="{Binding CancelJobCommand}" IsVisible="{Binding CanCancel}"
                  Padding="10,2" Focusable="False" />

          <!-- Export queue: a button with a flyout listing the jobs (progress, cancel, show file). -->
          <Button DataContext="{Binding RenderQueue}" x:DataType="vm:RenderQueueViewModel" IsVisible="{Binding HasJobs}"
                  Content="{Binding Summary}" Padding="10,2" Focusable="False" x:Name="JobsButton">
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedRight">
                <DockPanel Width="460" MaxHeight="420" Margin="4">
                  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Bitenleri temizle" Command="{Binding ClearFinishedCommand}" Padding="8,2" />
                    <TextBlock Text="Dışa aktarma işleri" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </DockPanel>
                  <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Jobs}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RenderJobViewModel">
                          <Border Classes="panel" Padding="10" Margin="0,0,0,6">
                            <StackPanel Spacing="4">
                              <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                  <Button Content="Göster" Command="{Binding RevealCommand}" IsVisible="{Binding IsDone}" Padding="8,2" />
                                  <Button Content="İptal" Command="{Binding CancelCommand}" IsVisible="{Binding IsActive}" Padding="8,2" />
                                </StackPanel>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OutputPath}" VerticalAlignment="Center" />
                              </DockPanel>
                              <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" IsVisible="{Binding IsActive}" />
                              <TextBlock Text="{Binding StateText}" Classes="muted" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Warning}" Classes="issues" TextWrapping="Wrap"
                                         IsVisible="{Binding Warning, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <TextBlock Text="{Binding PlatformText}" Classes="muted small" VerticalAlignment="Center" />
          <TextBlock Text="{Binding VersionText}" Classes="muted small" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Classes="small" Foreground="{DynamicResource SecondaryTextBrush}" />
      </DockPanel>
    </Border>

    <!-- Update banner (docked like the error banner, so the native video surface never covers it). -->
    <Border DockPanel.Dock="Top" Classes="info" IsVisible="{Binding HasUpdate}" Padding="14,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="accent small" Content="Yeniden başlat ve güncelle" Command="{Binding RestartToUpdateCommand}"
                  IsVisible="{Binding CanRestartToUpdate}" Focusable="False" />
          <Button Classes="accent small" Content="Sürüm sayfasını aç" Command="{Binding OpenReleasePageCommand}"
                  IsVisible="{Binding OffersDownloadPage}" Focusable="False" />
          <Button Classes="small" Content="Bu sürümü atla" Command="{Binding SkipUpdateCommand}"
                  IsVisible="{Binding OffersDownloadPage}" Focusable="False" />
          <Button Classes="ghost small" Content="Sonra" Command="{Binding DismissUpdateCommand}" Focusable="False" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <PathIcon Data="{StaticResource IconLogo}" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Text="{Binding UpdateText}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Error banner (not an overlay: the native video surface would hide it on Windows). -->
    <Border DockPanel.Dock="Top" Classes="error" IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Kapat" Command="{Binding DismissErrorCommand}" Focusable="False" />
        <SelectableTextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Main area: video + transport + timeline on the left, cue table + editor on the right. -->
    <Panel>
    <!-- Welcome screen (no project open): drop zone, recent files as cards, readiness checks. -->
    <ScrollViewer IsVisible="{Binding !HasProject}">
      <StackPanel MaxWidth="1040" Margin="40,48,40,32" Spacing="26">
        <StackPanel Spacing="6">
          <TextBlock Text="Hoş geldin" FontSize="28" FontWeight="Bold" />
          <TextBlock Text="Bir video aç, konuşmayı yazıya dök, düzelt, çevir ve altyazılı olarak dışa aktar." Classes="muted" FontSize="14" />
        </StackPanel>

        <!-- Drop zone: the whole window accepts drops; this only shows where. -->
        <Panel Height="230">
          <Rectangle RadiusX="16" RadiusY="16" Fill="{DynamicResource ChromeBackgroundBrush}"
                     Stroke="{DynamicResource StrongBorderBrush}" StrokeThickness="1.5" StrokeDashArray="5,4" />
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource IconVideo}" Width="26" Height="26" Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <TextBlock Text="Video ya da proje dosyasını buraya sürükle" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="MP4, MOV, MKV · SRT, VTT, ASS · .lingocue" Classes="muted" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,4,0,0">
              <Button Classes="accent" Content="Video aç" Command="{Binding OpenVideoCommand}" />
              <Button Content="Proje aç" Command="{Binding OpenProjectCommand}" />
            </StackPanel>
          </StackPanel>
        </Panel>

        <Grid ColumnDefinitions="2*,24,*">
          <StackPanel Spacing="12">
            <TextBlock Text="SON AÇILANLAR" Classes="section" />
            <TextBlock Text="Henüz açılmış bir dosya yok." Classes="muted" IsVisible="{Binding !HasRecentFiles}" />
            <ItemsControl ItemsSource="{Binding RecentFiles}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecentFileItem">
                  <Button Classes="card" Command="{Binding Open}" CommandParameter="{Binding Path}" ToolTip.Tip="{Binding Path}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <Border Width="40" Height="40" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}">
                        <Panel>
                          <PathIcon Data="{StaticResource IconFolder}" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsProject}" />
                          <PathIcon Data="{StaticResource IconVideo}" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding !IsProject}" />
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="muted small" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding Kind, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ShortFolder, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Grid.Column="2" Spacing="12">
            <TextBlock Text="HAZIRLIK" Classes="section" />
            <Border Classes="panel" Padding="14,4">
              <ItemsControl ItemsSource="{Binding Readiness}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ReadinessItem">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,9">
                      <Panel Width="20" Height="20" VerticalAlignment="Top">
                        <Border CornerRadius="10" Classes="chip ok" Padding="0" IsVisible="{Binding IsReady}">
                          <PathIcon Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource OkForegroundBrush}" />
                        </Border>
                        <Border CornerRadius="10" Classes="chip warn" Padding="0" IsVisible="{Binding !IsReady}">
                          <TextBlock Text="!" />
                        </Border>
                      </Panel>
                      <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="{Binding Label}" />
                        <TextBlock Text="{Binding Detail}" Classes="muted small" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <Grid Margin="12" ColumnDefinitions="5*,Auto,4*" IsVisible="{Binding HasProject}">
      <Grid Grid.Column="0" RowDefinitions="*,Auto,Auto,160">
        <Border Grid.Row="0" Classes="panel video" ClipToBounds="True">
          <Panel>
            <mpv:MpvView MpvContext="{Binding Player.Mpv}" Renderer="OpenGl" IsVisible="{Binding HasMedia}" />
            <!-- Guides only (drawn by Avalonia over the picture); subtitles come from libass. -->
            <views:SafeAreaOverlay VideoWidth="{Binding VideoWidth}" VideoHeight="{Binding VideoHeight}">
              <views:SafeAreaOverlay.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="HasMedia" />
                  <Binding Path="StyleEditor.ShowSafeArea" FallbackValue="False" />
                </MultiBinding>
              </views:SafeAreaOverlay.IsVisible>
            </views:SafeAreaOverlay>
            <!-- Resolution chip over the picture. -->
            <Border Classes="overlay" IsVisible="{Binding HasMedia}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12">
              <TextBlock Text="{Binding MediaSummary}" FontSize="11" Foreground="#E6E8EC" />
            </Border>
            <TextBlock Classes="placeholder" IsVisible="{Binding !HasMedia}"
                       Text="Video Aç ile bir video seçin ya da buraya sürükleyin (MP4, MOV, MKV).&#x0a;Altyazı (SRT, VTT, ASS) ve .lingocue projeleri de sürüklenebilir." />
          </Panel>
        </Border>

        <!-- Transport -->
        <Border Grid.Row="1" Classes="panel" Margin="0,10,0,0" Padding="10,5">
        <DockPanel DataContext="{Binding Player}" x:DataType="vm:PlayerViewModel"
                   IsEnabled="{Binding IsLoaded}">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4">
            <Button Classes="transport" Command="{Binding JumpBackCommand}" ToolTip.Tip="5 sn geri (←)">
              <PathIcon Data="M11,18V6L2.5,12L11,18M11.5,12L20,18V6L11.5,12Z" />
            </Button>
            <Button Classes="transport" Command="{Binding FrameBackCommand}" ToolTip.Tip="Önceki kare (Shift+←)">
              <PathIcon Data="M6,18V6H8V18H6M9.5,12L18,6V18L9.5,12Z" />
            </Button>
            <Button Classes="transport play" Command="{Binding TogglePlayPauseCommand}" ToolTip.Tip="Oynat / Duraklat (Boşluk)">
              <Panel>
                <PathIcon Data="M8,5.14V19.14L19,12.14L8,5.14Z" IsVisible="{Binding !IsPlaying}" />
                <PathIcon Data="M14,19H18V5H14M6,19H10V5H6V19Z" IsVisible="{Binding IsPlaying}" />
              </Panel>
            </Button>
            <Button Classes="transport" Command="{Binding FrameForwardCommand}" ToolTip.Tip="Sonraki kare (Shift+→)">
              <PathIcon Data="M16,18H18V6H16M6,18L14.5,12L6,6V18Z" />
            </Button>
            <Button Classes="transport" Command="{Binding JumpForwardCommand}" ToolTip.Tip="5 sn ileri (→)">
              <PathIcon Data="M13,6V18L21.5,12M4,18L12.5,12L4,6V18Z" />
            </Button>
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0,0,0">
            <TextBlock Text="{Binding PositionText}" FontFamily="{DynamicResource MonoFont}" />
            <TextBlock Text="/" Classes="muted" />
            <TextBlock Text="{Binding DurationText}" FontFamily="{DynamicResource MonoFont}" Classes="muted" />
          </StackPanel>
          <Slider Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds}"
                  Margin="12,0" VerticalAlignment="Center" Focusable="False" Classes="seek" />
        </DockPanel>
        </Border>

        <GridSplitter Grid.Row="2" Height="6" Background="Transparent" ResizeDirection="Rows" />
        <!-- Timeline: drawn in code (TimelineControl); tooltip lists the mouse actions. -->
        <Border Grid.Row="3" Classes="panel" Padding="0" ClipToBounds="True">
          <views:TimelineControl DataContext="{Binding Timeline}"
                                 ToolTip.Tip="Tıkla: oraya git · Bloğu sürükle: kaydır · Kenarı sürükle: başlangıç/bitiş · Tekerlek: kaydır · Ctrl/⌘+tekerlek: yakınlaştır" />
        </Border>
      </Grid>

      <GridSplitter Grid.Column="1" Width="6" Background="Transparent" ResizeDirection="Columns" />

      <!-- Right panel: track row, segmented tabs (Satırlar / Stil / Kontrol). -->
      <Border Grid.Column="2" Classes="panel" Padding="0" ClipToBounds="True">
       <DockPanel>
        <!-- Track selector; "İzler…" opens track management. -->
        <DockPanel DockPanel.Dock="Top" Margin="12,12,12,0" IsVisible="{Binding HasProject}">
          <Button DockPanel.Dock="Right" Content="İzler…" Command="{Binding ManageTracksCommand}" Margin="8,0,0,0" Focusable="False"
                  ToolTip.Tip="İzleri yönet: ad, dil, sıra, çoğalt, sil, zamanlamayı kaynaktan al" />
          <ComboBox ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}" HorizontalAlignment="Stretch" Focusable="False"
                    ToolTip.Tip="Düzenlenen iz">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="sub:SubtitleTrack">
                <TextBlock>
                  <Run Text="{Binding Name, Mode=OneWay}" />
                  <Run Text="{Binding Language, StringFormat=' · {0}', Mode=OneWay}" Foreground="{DynamicResource MutedTextBrush}" />
                  <Run Text="{Binding Cues.Count, StringFormat=' · {0} satır', Mode=OneWay}" Foreground="{DynamicResource MutedTextBrush}" />
                </TextBlock>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </DockPanel>
        <!-- Lines / Style / QA tabs: the video stays visible while styling. -->
        <TabControl Classes="segmented" SelectedIndex="{Binding SelectedPanel}">
          <TabItem Header="Satırlar">
        <DockPanel DataContext="{Binding Editor}" x:DataType="vm:SubtitleEditorViewModel">

          <!-- Summary and list actions; the actions wrap in a narrow panel. -->
          <StackPanel DockPanel.Dock="Top" Margin="12,10,12,8" Spacing="8">
            <DockPanel>
              <CheckBox DockPanel.Dock="Right" Content="Oynatmayı takip et" IsChecked="{Binding FollowPlayback}" Focusable="False" />
              <TextBlock Text="{Binding Summary}" Classes="muted small" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <WrapPanel ItemSpacing="6" LineSpacing="6">
              <Button Classes="small" Content="+ Satır" Command="{Binding AddCueCommand}" Focusable="False"
                      ToolTip.Tip="Oynatma konumuna yeni satır ekle (Ctrl+Enter)" />
              <Button Classes="small" Content="Böl" Command="{Binding SplitCueCommand}" Focusable="False"
                      ToolTip.Tip="Seçili satırı böl (Ctrl+B)" />
              <Button Classes="small" Content="Birleştir" Command="{Binding MergeWithNextCommand}" Focusable="False"
                      ToolTip.Tip="Sonraki satırla birleştir (Ctrl+M)" />
              <Button Classes="small danger" Content="Sil" Command="{Binding DeleteCueCommand}" Focusable="False"
                      ToolTip.Tip="Seçili satırı sil" />
              <CheckBox Content="{Binding FilterLabel}" IsChecked="{Binding ShowChangedOnly}" Focusable="False"
                        IsVisible="{Binding HasSourceTrack}" Margin="6,0,0,0"
                        ToolTip.Tip="{Binding FilterTip}" />
            </WrapPanel>
          </StackPanel>

          <!-- Find / replace bar (Ctrl/⌘+F); Enter in the search box finds the next match. -->
          <Border DockPanel.Dock="Top" Classes="well" Margin="12,0,12,8" IsVisible="{Binding IsFindOpen}">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="6">
              <TextBox x:Name="FindBox" Text="{Binding FindText}" PlaceholderText="Bul (Türkçe büyük/küçük harf kurallarıyla)" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button Classes="icon" Content="↑" Command="{Binding FindPreviousCommand}" ToolTip.Tip="Önceki (Shift+Enter)" Focusable="False" />
                <Button Classes="icon" Content="↓" Command="{Binding FindNextCommand}" ToolTip.Tip="Sonraki (Enter)" Focusable="False" />
                <Button Classes="icon" Content="✕" Command="{Binding CloseFindCommand}" ToolTip.Tip="Kapat (Esc)" Focusable="False" />
              </StackPanel>
              <TextBox Grid.Row="1" Text="{Binding ReplaceText}" PlaceholderText="Değiştir" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button Content="Değiştir" Command="{Binding ReplaceOneCommand}" Focusable="False" />
                <Button Content="Tümü" Command="{Binding ReplaceAllCommand}" Focusable="False" ToolTip.Tip="Hepsini değiştir (tek adımda geri alınabilir)" />
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12">
                <CheckBox Content="Büyük/küçük harf" IsChecked="{Binding MatchCase}" Focusable="False" />
                <CheckBox Content="Tam kelime" IsChecked="{Binding WholeWord}" Focusable="False" />
                <TextBlock Text="{Binding FindStatus}" Classes="muted" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Edit card for the selected line. -->
          <Border DockPanel.Dock="Bottom" Classes="chrome" BorderThickness="0,1,0,0" Padding="12" IsEnabled="{Binding HasSelection}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,12,*">
                <StackPanel Spacing="4">
                  <TextBlock Text="Başlangıç" Classes="muted small" />
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding SetStartToPlayheadCommand}" Focusable="False"
                            ToolTip.Tip="Başlangıcı oynatma konumuna al ([)" Margin="4,0,0,0">
                      <PathIcon Data="{StaticResource IconClock}" />
                    </Button>
                    <TextBox Classes="mono" Text="{Binding SelectedCue.StartInput, UpdateSourceTrigger=LostFocus, FallbackValue=''}" x:Name="StartBox" />
                  </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                  <TextBlock Text="Bitiş" Classes="muted small" />
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding SetEndToPlayheadCommand}" Focusable="False"
                            ToolTip.Tip="Bitişi oynatma konumuna al (])" Margin="4,0,0,0">
                      <PathIcon Data="{StaticResource IconClock}" />
                    </Button>
                    <TextBox Classes="mono" Text="{Binding SelectedCue.EndInput, UpdateSourceTrigger=LostFocus, FallbackValue=''}" />
                  </DockPanel>
                </StackPanel>
              </Grid>

              <TextBox MinHeight="64" Text="{Binding SelectedCue.Text, FallbackValue=''}"
                       AcceptsReturn="True" TextWrapping="Wrap" x:Name="CueTextBox"
                       PlaceholderText="Altyazı metni (Enter ile yeni satır)" />

              <Grid ColumnDefinitions="Auto,160,*" ColumnSpacing="8">
                <TextBlock Text="Konuşmacı" Classes="muted small" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding SelectedCue.Speaker, FallbackValue=''}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right"
                           Text="{Binding SelectedCue.IssuesText, FallbackValue=''}" Classes="issues" TextWrapping="Wrap" />
              </Grid>

              <!-- Words speech recognition was unsure of: each one plays from just before it. -->
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding SelectedCue.HasDoubtfulWords, FallbackValue=False}">
                <TextBlock Classes="muted small" Text="Emin olunmayan kelimeler:" VerticalAlignment="Center" />
                <ItemsControl ItemsSource="{Binding SelectedCue.DoubtfulWords, FallbackValue={x:Null}}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sub:Word">
                      <Button Classes="small doubtful" Margin="0,0,6,0" Focusable="False"
                              Command="{Binding $parent[ItemsControl].((vm:SubtitleEditorViewModel)DataContext).PlayWordCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="Bu kelimeden biraz önceden oynat">
                        <TextBlock Text="{Binding Text}" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Original text from the source track, for corrected/translated tracks. -->
              <DockPanel IsVisible="{Binding SelectedCue.HasOriginal, FallbackValue=False}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                  <Button Classes="small" Content="Orijinale dön" Command="{Binding RevertToOriginalCommand}" Focusable="False"
                          IsEnabled="{Binding SelectedCue.IsChanged, FallbackValue=False}" />
                  <Button Classes="small" Content="Kontrol edildi" Command="{Binding MarkReviewedCommand}" Focusable="False"
                          IsVisible="{Binding SelectedCue.IsFlagged, FallbackValue=False}" />
                </StackPanel>
                <TextBlock Classes="muted small" TextWrapping="Wrap" VerticalAlignment="Center">
                  <Run Text="Orijinal: " /><Run Text="{Binding SelectedCue.OriginalText, FallbackValue='', Mode=OneWay}" Foreground="{DynamicResource SecondaryTextBrush}" />
                </TextBlock>
              </DockPanel>
            </StackPanel>
          </Border>

          <!-- The lines. SelectedItem is synced in code-behind: an unloaded tab would otherwise write "no selection" back. -->
          <ListBox x:Name="CueGrid" Classes="cues" ItemsSource="{Binding VisibleCues}" SelectionMode="Single"
                   BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelBorderBrush}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:CueViewModel">
                <Grid ColumnDefinitions="3,40,*,Auto">
                  <Border Background="{DynamicResource AccentBrush}" IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
                  <TextBlock Grid.Column="1" Text="{Binding Number}" Classes="num" Classes.current="{Binding IsCurrent}"
                             HorizontalAlignment="Right" Margin="0,10,0,0" />
                  <StackPanel Grid.Column="2" Margin="12,8,8,8" Spacing="3">
                    <TextBlock Classes="mono muted" FontSize="11">
                      <Run Text="{Binding StartText, Mode=OneWay}" /><Run Text=" → " /><Run Text="{Binding EndText, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding DurationText, Mode=OneWay}" /><Run Text=" sn" />
                    </TextBlock>
                    <TextBlock Text="{Binding OneLineText}" TextTrimming="CharacterEllipsis"
                               Classes.hasError="{Binding HasError}" ToolTip.Tip="{Binding TextTip}" />
                  </StackPanel>
                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MarkGlyph}" ToolTip.Tip="{Binding MarkTip}" Classes="mark"
                               Classes.review="{Binding NeedsReview}" Classes.failed="{Binding LlmFailed}" />
                    <Border Classes="chip" Classes.ok="{Binding CpsOk}" Classes.warn="{Binding CpsHigh}" Classes.err="{Binding CpsTooHigh}"
                            MinWidth="46" ToolTip.Tip="Okuma hızı (karakter/sn)">
                      <TextBlock Text="{Binding CpsText}" />
                    </Border>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
          </TabItem>
          <TabItem Header="Stil">
            <views:StyleEditorView DataContext="{Binding StyleEditor}" />
          </TabItem>
          <!-- QA: every rule problem of the track; picking one selects the line and seeks there. -->
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Kontrol" VerticalAlignment="Center" />
                <Border Classes="chip warn" Padding="6,0" IsVisible="{Binding Quality.HasIssues, FallbackValue=False}">
                  <TextBlock Text="{Binding Quality.IssueCount, FallbackValue=''}" />
                </Border>
              </StackPanel>
            </TabItem.Header>
            <DockPanel DataContext="{Binding Quality}" x:DataType="vm:QualityViewModel">
              <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="12,10,12,10">
                <Grid ColumnDefinitions="*,8,*,8,*">
                  <Border Classes="tile err">
                    <StackPanel><TextBlock Text="{Binding ErrorCount}" Classes="tilevalue" /><TextBlock Text="hata" Classes="small" /></StackPanel>
                  </Border>
                  <Border Grid.Column="2" Classes="tile warn">
                    <StackPanel><TextBlock Text="{Binding WarningCount}" Classes="tilevalue" /><TextBlock Text="uyarı" Classes="small" /></StackPanel>
                  </Border>
                  <Border Grid.Column="4" Classes="tile ok">
                    <StackPanel><TextBlock Text="{Binding CleanCount}" Classes="tilevalue" /><TextBlock Text="sorunsuz satır" Classes="small" /></StackPanel>
                  </Border>
                </Grid>
                <Grid ColumnDefinitions="*,8,*">
                  <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding FixOverlapsCommand}" Focusable="False"
                          ToolTip.Tip="Üst üste binen satırları bir sonrakinin hemen öncesinde bitirir">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource IconWrench}" Width="14" Height="14" />
                      <TextBlock Text="Çakışmaları gider" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ExtendForReadingSpeedCommand}" Focusable="False"
                          ToolTip.Tip="Hızlı okunan satırları, sonraki satıra değmeden hedef okuma hızına kadar uzatır">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource IconClock}" Width="14" Height="14" />
                      <TextBlock Text="Okuma hızı için uzat" />
                    </StackPanel>
                  </Button>
                </Grid>
                <TextBlock Text="{Binding FixStatus}" Classes="muted small" TextWrapping="Wrap"
                           IsVisible="{Binding FixStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
              <ListBox Classes="cues" ItemsSource="{Binding Issues}" SelectedItem="{Binding SelectedIssue}"
                       BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelBorderBrush}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:QaIssueItem">
                    <Grid ColumnDefinitions="3,Auto,*" Margin="0">
                      <Border Background="{DynamicResource AccentBrush}" IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
                      <Border Grid.Column="1" Classes="chip" Classes.err="{Binding IsError}" Classes.warn="{Binding !IsError}"
                              Width="22" Height="22" CornerRadius="11" Padding="0" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Glyph}" />
                      </Border>
                      <StackPanel Grid.Column="2" Margin="12,9" Spacing="2">
                        <TextBlock Text="{Binding Issue.Message}" TextWrapping="Wrap" />
                        <TextBlock Classes="muted small">
                          <Run Text="Satır " /><Run Text="{Binding Issue.Number, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TimeText, Mode=OneWay}" FontFamily="{DynamicResource MonoFont}" />
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </TabItem>
        </TabControl>
       </DockPanel>
      </Border>
    </Grid>
    </Panel>
  </DockPanel>
</Window>
