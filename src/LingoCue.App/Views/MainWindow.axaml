<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LingoCue.App.ViewModels"
        xmlns:mpv="using:HanumanInstitute.LibMpv.Avalonia"
        xmlns:sub="using:LingoCue.Core.Subtitles"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="LingoCue.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/lingocue.ico"
        Title="{Binding Title}"
        Width="1200" Height="720" WindowState="Maximized"
        MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenVideoCommand}" />
    <KeyBinding Gesture="Meta+O" Command="{Binding OpenVideoCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveProjectCommand}" />
    <KeyBinding Gesture="Meta+S" Command="{Binding SaveProjectCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveProjectAsCommand}" />
    <KeyBinding Gesture="Meta+Shift+S" Command="{Binding SaveProjectAsCommand}" />
    <KeyBinding Gesture="Ctrl+I" Command="{Binding ImportSubtitleCommand}" />
    <KeyBinding Gesture="Meta+I" Command="{Binding ImportSubtitleCommand}" />
    <KeyBinding Gesture="Ctrl+T" Command="{Binding TranscribeCommand}" />
    <KeyBinding Gesture="Meta+T" Command="{Binding TranscribeCommand}" />
  </Window.KeyBindings>

  <DockPanel>

    <!-- Menu -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_Dosya">
        <MenuItem Header="_Video Aç…" InputGesture="Ctrl+O" Command="{Binding OpenVideoCommand}" />
        <MenuItem Header="_Proje Aç…" Command="{Binding OpenProjectCommand}" />
        <Separator />
        <MenuItem Header="_Kaydet" InputGesture="Ctrl+S" Command="{Binding SaveProjectCommand}" />
        <MenuItem Header="_Farklı Kaydet…" InputGesture="Ctrl+Shift+S" Command="{Binding SaveProjectAsCommand}" />
        <Separator />
        <MenuItem Header="Altyazı _İçe Aktar…" InputGesture="Ctrl+I" Command="{Binding ImportSubtitleCommand}" />
        <MenuItem Header="Altyazı _Dışa Aktar">
          <MenuItem Header="SRT (Premiere Pro)…" Command="{Binding ExportSubtitleCommand}" CommandParameter="srt" />
          <MenuItem Header="WebVTT…" Command="{Binding ExportSubtitleCommand}" CommandParameter="vtt" />
          <MenuItem Header="ASS (stilli)…" Command="{Binding ExportSubtitleCommand}" CommandParameter="ass" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Altyazı">
        <MenuItem Header="_Transkribe Et…" InputGesture="Ctrl+T" Command="{Binding TranscribeCommand}" />
        <MenuItem Header="_Düzelt…" Command="{Binding CorrectCommand}" />
        <MenuItem Header="_Sözlük ve Bağlam…" Command="{Binding EditGlossaryCommand}" />
      </MenuItem>
      <MenuItem Header="A_yarlar">
        <MenuItem Header="_Tercihler…" InputGesture="Ctrl+OemComma" Command="{Binding PreferencesCommand}" />
      </MenuItem>
    </Menu>

    <!-- Toolbar: actions are enabled milestone by milestone. -->
    <Border DockPanel.Dock="Top" Padding="8,6" BorderThickness="0,1,0,1"
            BorderBrush="{DynamicResource PanelBorderBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="Tema" VerticalAlignment="Center" Classes="muted" />
          <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" MinWidth="110" Focusable="False" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="Video Aç" Command="{Binding OpenVideoCommand}" Focusable="False"
                  ToolTip.Tip="Video aç (Ctrl+O / ⌘O)" />
          <Button Content="Kaydet" Command="{Binding SaveProjectCommand}" Focusable="False"
                  ToolTip.Tip="Projeyi kaydet (Ctrl+S / ⌘S)" />
          <Separator Width="1" Margin="4,2" />
          <Button Content="Transkribe Et" Command="{Binding TranscribeCommand}" Focusable="False"
                  ToolTip.Tip="Konuşmayı tanı ve altyazı oluştur (Ctrl+T / ⌘T)" />
          <Button Content="Düzelt" Command="{Binding CorrectCommand}" ToolTip.Tip="Yapay zekâ ile tanıma hatalarını düzelt" />
          <Button Content="Çevir" IsEnabled="False" ToolTip.Tip="M7" />
          <Button Content="Stil" IsEnabled="False" ToolTip.Tip="M5" />
          <Button Content="Dışa Aktar" IsEnabled="False" ToolTip.Tip="M6 (şimdilik Dosya → Altyazı Dışa Aktar)" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Status bar with progress + cancel for long-running jobs. -->
    <Border DockPanel.Dock="Bottom" Padding="10,4" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource PanelBorderBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10">
          <ProgressBar Width="180" Minimum="0" Maximum="1" Value="{Binding Progress}"
                       IsIndeterminate="{Binding IsProgressIndeterminate}" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
          <Button Content="İptal" Command="{Binding CancelJobCommand}" IsVisible="{Binding CanCancel}"
                  Padding="10,2" Focusable="False" />
          <TextBlock Text="{Binding PlatformText}" Classes="muted" VerticalAlignment="Center" />
          <TextBlock Text="{Binding VersionText}" Classes="muted" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- Error banner (not an overlay: the native video surface would hide it on Windows). -->
    <Border DockPanel.Dock="Top" Classes="error" IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Kapat" Command="{Binding DismissErrorCommand}" Focusable="False" />
        <SelectableTextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Main area: video + transport + timeline on the left, cue table + editor on the right. -->
    <Grid Margin="8" ColumnDefinitions="5*,Auto,4*">
      <Grid Grid.Column="0" RowDefinitions="*,Auto,Auto,110">
        <Border Grid.Row="0" Classes="panel video" ClipToBounds="True">
          <Panel>
            <mpv:MpvView MpvContext="{Binding Player.Mpv}" Renderer="OpenGl" IsVisible="{Binding HasMedia}" />
            <TextBlock Classes="placeholder" IsVisible="{Binding !HasMedia}"
                       Text="Video Aç ile bir video seçin ya da buraya sürükleyin (MP4, MOV, MKV).&#x0a;Altyazı (SRT, VTT, ASS) ve .lingocue projeleri de sürüklenebilir." />
          </Panel>
        </Border>

        <!-- Transport -->
        <DockPanel Grid.Row="1" Margin="0,6,0,0" DataContext="{Binding Player}" x:DataType="vm:PlayerViewModel"
                   IsEnabled="{Binding IsLoaded}">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4">
            <Button Classes="transport" Command="{Binding JumpBackCommand}" ToolTip.Tip="5 sn geri (←)">
              <PathIcon Data="M11,18V6L2.5,12L11,18M11.5,12L20,18V6L11.5,12Z" />
            </Button>
            <Button Classes="transport" Command="{Binding FrameBackCommand}" ToolTip.Tip="Önceki kare (Shift+←)">
              <PathIcon Data="M6,18V6H8V18H6M9.5,12L18,6V18L9.5,12Z" />
            </Button>
            <Button Classes="transport play" Command="{Binding TogglePlayPauseCommand}" ToolTip.Tip="Oynat / Duraklat (Boşluk)">
              <Panel>
                <PathIcon Data="M8,5.14V19.14L19,12.14L8,5.14Z" IsVisible="{Binding !IsPlaying}" />
                <PathIcon Data="M14,19H18V5H14M6,19H10V5H6V19Z" IsVisible="{Binding IsPlaying}" />
              </Panel>
            </Button>
            <Button Classes="transport" Command="{Binding FrameForwardCommand}" ToolTip.Tip="Sonraki kare (Shift+→)">
              <PathIcon Data="M16,18H18V6H16M6,18L14.5,12L6,6V18Z" />
            </Button>
            <Button Classes="transport" Command="{Binding JumpForwardCommand}" ToolTip.Tip="5 sn ileri (→)">
              <PathIcon Data="M13,6V18L21.5,12M4,18L12.5,12L4,6V18Z" />
            </Button>
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0,0,0">
            <TextBlock Text="{Binding PositionText}" FontFamily="{DynamicResource MonoFont}" />
            <TextBlock Text="/" Classes="muted" />
            <TextBlock Text="{Binding DurationText}" FontFamily="{DynamicResource MonoFont}" Classes="muted" />
          </StackPanel>
          <Slider Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds}"
                  Margin="8,0" VerticalAlignment="Center" Focusable="False" />
        </DockPanel>

        <GridSplitter Grid.Row="2" Height="6" Background="Transparent" ResizeDirection="Rows" />
        <Border Grid.Row="3" Classes="panel">
          <TextBlock Classes="placeholder" Text="Zaman çizelgesi / dalga formu (M8)" />
        </Border>
      </Grid>

      <GridSplitter Grid.Column="1" Width="6" Background="Transparent" ResizeDirection="Columns" />

      <!-- Cue list + editor -->
      <Border Grid.Column="2" Classes="panel" Padding="0">
       <DockPanel>
        <!-- Track selector (full track management in M7) -->
        <DockPanel DockPanel.Dock="Top" Margin="8,6,8,0" IsVisible="{Binding HasSeveralTracks}">
          <TextBlock Text="İz" VerticalAlignment="Center" Margin="0,0,8,0" Classes="muted" />
          <ComboBox ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}" HorizontalAlignment="Stretch" Focusable="False">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="sub:SubtitleTrack">
                <TextBlock>
                  <Run Text="{Binding Name}" />
                  <Run Text="{Binding Cues.Count, StringFormat=' · {0} satır'}" Foreground="{DynamicResource MutedTextBrush}" />
                </TextBlock>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </DockPanel>
        <DockPanel DataContext="{Binding Editor}" x:DataType="vm:SubtitleEditorViewModel">

          <!-- Header: summary + list actions -->
          <DockPanel DockPanel.Dock="Top" Margin="8,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
              <CheckBox Content="Oynatmayı takip et" IsChecked="{Binding FollowPlayback}" Focusable="False" />
              <Button Content="+ Satır" Command="{Binding AddCueCommand}" Focusable="False"
                      ToolTip.Tip="Oynatma konumuna yeni satır ekle" />
              <Button Content="Sil" Command="{Binding DeleteCueCommand}" Focusable="False"
                      ToolTip.Tip="Seçili satırı sil" />
            </StackPanel>
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Classes="muted" />
          </DockPanel>

          <!-- Editor for the selected cue -->
          <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelBorderBrush}"
                  Padding="8" IsEnabled="{Binding HasSelection}">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto,*" >
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Başlangıç" VerticalAlignment="Center" Margin="0,0,6,0" />
              <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,0">
                <Button DockPanel.Dock="Right" Content="⏱" Command="{Binding SetStartToPlayheadCommand}" Focusable="False"
                        ToolTip.Tip="Başlangıcı oynatma konumuna ayarla" Margin="4,0,0,0" />
                <TextBox Text="{Binding SelectedCue.StartInput, UpdateSourceTrigger=LostFocus, FallbackValue=''}"
                         FontFamily="{DynamicResource MonoFont}" x:Name="StartBox" />
              </DockPanel>
              <TextBlock Grid.Row="0" Grid.Column="2" Text="Bitiş" VerticalAlignment="Center" Margin="0,0,6,0" />
              <DockPanel Grid.Row="0" Grid.Column="3">
                <Button DockPanel.Dock="Right" Content="⏱" Command="{Binding SetEndToPlayheadCommand}" Focusable="False"
                        ToolTip.Tip="Bitişi oynatma konumuna ayarla" Margin="4,0,0,0" />
                <TextBox Text="{Binding SelectedCue.EndInput, UpdateSourceTrigger=LostFocus, FallbackValue=''}"
                         FontFamily="{DynamicResource MonoFont}" />
              </DockPanel>

              <TextBox Grid.Row="1" Grid.ColumnSpan="4" Margin="0,8,0,0" MinHeight="64"
                       Text="{Binding SelectedCue.Text, FallbackValue=''}"
                       AcceptsReturn="True" TextWrapping="Wrap" x:Name="CueTextBox"
                       PlaceholderText="Altyazı metni (Enter ile yeni satır)" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Konuşmacı" VerticalAlignment="Center" Margin="0,8,6,0" />
              <TextBox Grid.Row="2" Grid.Column="1" Margin="0,8,12,0" Text="{Binding SelectedCue.Speaker, FallbackValue=''}" />
              <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,8,0,0" VerticalAlignment="Center"
                         Text="{Binding SelectedCue.IssuesText, FallbackValue=''}" Classes="issues" TextWrapping="Wrap" />
            </Grid>
          </Border>

          <DataGrid x:Name="CueGrid" ItemsSource="{Binding Cues}" SelectedItem="{Binding SelectedCue}"
                    IsReadOnly="True" SelectionMode="Single" CanUserSortColumns="False" CanUserReorderColumns="False"
                    GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="28" FontSize="13">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="#" Width="44">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:CueViewModel">
                    <Panel>
                      <Border Classes="current" IsVisible="{Binding IsCurrent}" />
                      <TextBlock Text="{Binding Number}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" />
                    </Panel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Başlangıç" Binding="{Binding StartText}" Width="136" FontFamily="{DynamicResource MonoFont}" />
              <DataGridTextColumn Header="Bitiş" Binding="{Binding EndText}" Width="136" FontFamily="{DynamicResource MonoFont}" />
              <DataGridTextColumn Header="Süre" Binding="{Binding DurationText}" Width="62" />
              <DataGridTemplateColumn Header="CPS" Width="62">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:CueViewModel">
                    <Border Classes.cpsHigh="{Binding CpsHigh}" Classes.cpsTooHigh="{Binding CpsTooHigh}" Padding="6,0">
                      <TextBlock Text="{Binding CpsText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Metin" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:CueViewModel">
                    <TextBlock Text="{Binding OneLineText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0"
                               Classes.hasError="{Binding HasError}" ToolTip.Tip="{Binding IssuesText}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Konuşmacı" Binding="{Binding Speaker}" Width="104" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
       </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
