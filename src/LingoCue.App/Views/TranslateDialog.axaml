<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LingoCue.App.ViewModels"
        xmlns:sub="using:LingoCue.Core.Subtitles"
        x:Class="LingoCue.App.Views.TranslateDialog"
        x:DataType="vm:TranslateDialogViewModel"
        Title="Çevir"
        Width="620" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <DockPanel>
  <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="20,18,20,4">
    <Border Classes="dlgicon"><PathIcon Data="{StaticResource IconTranslate}" /></Border>
    <StackPanel Grid.Column="1" Spacing="2">
      <TextBlock Text="Çevir" Classes="h1" />
      <TextBlock TextWrapping="Wrap" Classes="muted small"
                 Text="Seçilen iz yeni bir iz olarak çevrilir; zamanlama birebir kopyalanır, kaynak iz değişmez. Düzenlediğin metin esas alınır." />
    </StackPanel>
  </Grid>
  <Border DockPanel.Dock="Bottom" Classes="dlgfooter">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Vazgeç" IsCancel="True" Click="OnCancel" MinWidth="90" />
      <Button Content="Çevir" Classes="accent" IsDefault="True" IsEnabled="{Binding CanStart}" Click="OnStart" MinWidth="90" />
    </StackPanel>
  </Border>
  <StackPanel Margin="20,12,20,18" Spacing="12">

    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
      <TextBlock Text="Kaynak iz" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="sub:SubtitleTrack">
            <TextBlock>
              <Run Text="{Binding Name, Mode=OneWay}" />
              <Run Text="{Binding Language, StringFormat=' · {0}', Mode=OneWay}" Foreground="{DynamicResource MutedTextBrush}" />
            </TextBlock>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SourceInfo}" Classes="muted" TextWrapping="Wrap" />

      <TextBlock Grid.Row="2" Text="Hedef diller" VerticalAlignment="Top" Margin="0,6,0,0" />
      <!-- Chips: several targets can be selected; each becomes its own track. -->
      <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Targets}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel ItemSpacing="6" LineSpacing="6" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TargetLanguageItem">
            <ToggleButton Classes="chiptoggle" Content="{Binding Label}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsEnabled}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <TextBlock Text="En az bir hedef dil seçin (kaynak izin kendi dili seçilemez)." Classes="issues" IsVisible="{Binding NoTarget}" />
    <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding HasKorean}"
               Text="Korece: kibar konuşma dili (해요체), isimler Hangul ile; satır başına 16 karakter ve saniyede en fazla 12 karakter kuralı uygulanır. Videoya gömmek için Hangul içeren bir font gerekir." />

    <CheckBox Content="Önce videonun bağlamını çıkar (özet, ton, konuşmacılar → tutarlı terimler ve zamirler)" IsChecked="{Binding RefreshContext}" />
    <CheckBox Content="İkinci geçişte gözden geçir (daha doğal ve tutarlı, maliyet ~2 kat)" IsChecked="{Binding Reflect}" />

    <Border Classes="well">
      <TextBlock Text="{Binding EstimateText}" TextWrapping="Wrap" />
    </Border>

    <Border Classes="error" Margin="0" IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" />
    </Border>
  </StackPanel>
  </DockPanel>
</Window>
