<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LingoCue.App.ViewModels"
        xmlns:tr="using:LingoCue.Transcription"
        x:Class="LingoCue.App.Views.SettingsDialog"
        x:DataType="vm:SettingsViewModel"
        Title="Tercihler"
        Width="720" Height="600" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="Vazgeç" IsCancel="True" Click="OnCancel" MinWidth="90" />
      <Button Content="Kaydet" Classes="accent" IsDefault="True" Click="OnSave" MinWidth="90" />
    </StackPanel>

    <TabControl>
      <!-- General -->
      <TabItem Header="Genel">
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="0,12">
          <!-- Hardware: what this machine can run, with a one-click suggestion. -->
          <Border Classes="well" IsVisible="{Binding HasAdvice}">
            <StackPanel Spacing="6">
              <TextBlock Text="BU BİLGİSAYAR" Classes="section" />
              <TextBlock Text="{Binding HardwareText}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding AdviceText}" Classes="muted small" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Önerilen ayarları uygula" Command="{Binding ApplyRecommendedCommand}" />
                <TextBlock Text="{Binding AdviceStatus}" Classes="muted small" VerticalAlignment="Center" TextWrapping="Wrap"
                           IsVisible="{Binding AdviceStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
            <TextBlock Text="Varsayılan transkripsiyon motoru" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Engines}" SelectedItem="{Binding SelectedEngine}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="tr:ITranscriptionEngine">
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="1" Text="Whisper modeli" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding WhisperModels}" SelectedItem="{Binding WhisperModel}" />
            <TextBlock Grid.Row="2" Text="Konuşma dili" VerticalAlignment="Center" />
            <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LanguageCodes}" SelectedItem="{Binding Language}" />
            <TextBlock Grid.Row="3" Text="Whisper doğruluğu" VerticalAlignment="Center" />
            <ComboBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding BeamSearchModes}" SelectedItem="{Binding BeamSearchMode}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:BeamSearchChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Grid.Row="4" Grid.Column="1" Spacing="6">
              <CheckBox IsChecked="{Binding UseGlossaryHints}"
                        Content="Sözlükteki adları Whisper'a yazım ipucu olarak ver (özel isimler daha doğru yazılır)" />
              <!-- Apple Silicon only: whisper.cpp uses the Core ML encoder when it sits next to the model. -->
              <CheckBox IsChecked="{Binding UseNeuralEngine}" IsVisible="{Binding IsAppleSilicon}"
                        Content="Neural Engine hızlandırması (Apple Silicon; ilk kullanımda ~1,2 GB indirilir, ilk çalıştırma birkaç dakika sürebilir)" />
            </StackPanel>
            <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Classes="muted" TextWrapping="Wrap"
                       Text="Whisper yereldir ve ücretsizdir. Gemini 3.5 Transcribe gürültülü ve çok konuşmacılı videolarda daha iyidir ama ücretlidir (~0,005 $/dk)." />
          </Grid>
          <!-- Updates: on by default; only the latest version number is asked from GitHub. -->
          <Border Classes="well">
            <StackPanel Spacing="6">
              <TextBlock Text="GÜNCELLEMELER" Classes="section" />
              <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" />
              <CheckBox IsChecked="{Binding AutoCheckUpdates}"
                        Content="Açılışta yeni sürümü denetle (günde en fazla bir kez)" />
              <TextBlock Classes="muted small" TextWrapping="Wrap"
                         Text="GitHub'a yalnızca en son sürümün numarası sorulur; videolarınız, projeleriniz ya da anahtarlarınız gönderilmez. Windows'ta kurulumla yüklenen sürüm güncellemeyi kendisi indirir; macOS'ta sürüm sayfası açılır." />
            </StackPanel>
          </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- LLM -->
      <TabItem Header="Dil modeli (LLM)">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="0,12">
            <!-- Default engine; Düzelt and Çevir can switch per run. -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
              <TextBlock Text="Varsayılan motor" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LlmEngines}" SelectedItem="{Binding DefaultLlmEngine}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:EngineChoice">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <Border Classes="well">
              <StackPanel Spacing="8">
                <TextBlock Text="YEREL MODEL (OLLAMA)" Classes="section" />
                <TextBlock Classes="muted small" TextWrapping="Wrap"
                           Text="Ücretsizdir, içerik bilgisayardan çıkmaz ve hız sınırı yoktur. Ollama'yı kurun (Windows: winget install Ollama.Ollama · macOS: brew install ollama), bir model indirin (ör. ollama pull gemma3:12b) ve buradan seçin. 8 GB ve üzeri ekran kartı belleği önerilir." />
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="8">
                  <TextBlock Text="Adres" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding OllamaUrl}" />
                  <Button Grid.Column="2" Content="Bağlan ve listele" Command="{Binding RefreshLocalModelsCommand}" />
                  <TextBlock Grid.Row="1" Text="Model" VerticalAlignment="Center" />
                  <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalModels}" SelectedItem="{Binding LocalModel}" />
                </Grid>
                <TextBlock Text="{Binding LocalStatus}" Classes="muted small" TextWrapping="Wrap"
                           IsVisible="{Binding LocalStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Grid ColumnDefinitions="Auto,140,Auto,140" ColumnSpacing="12">
                  <TextBlock Text="İstek başına satır" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="1" Minimum="5" Maximum="40" Increment="5" Value="{Binding LocalBatchSize}" FormatString="0" />
                  <TextBlock Grid.Column="2" Text="Aynı anda istek" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="3" Minimum="1" Maximum="4" Value="{Binding LocalParallelism}" FormatString="0"
                                 ToolTip.Tip="1'den fazlası için ekran kartında boş bellek gerekir; Ollama'da OLLAMA_NUM_PARALLEL de en az bu kadar olmalı." />
                </Grid>
                <TextBlock Text="{Binding AdviceText}" Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding HasAdvice}" />
              </StackPanel>
            </Border>
            <TextBlock Text="GEMINI (BULUT)" Classes="section" Margin="0,6,0,0" />
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="10">
              <TextBlock Text="Günlük model" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding FastModels}" SelectedItem="{Binding SelectedFast}" />
              <Button Grid.Column="2" Content="Modelleri yenile" Command="{Binding RefreshModelsCommand}" Margin="8,0,0,0" />
              <TextBlock Grid.Row="1" Text="Kalite modu modeli" VerticalAlignment="Center" />
              <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding QualityModels}" SelectedItem="{Binding SelectedQuality}" />
            </Grid>
            <TextBlock Text="{Binding ModelStatus}" Classes="muted" TextWrapping="Wrap"
                       IsVisible="{Binding ModelStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <CheckBox Content="Kalite modunu kullan (daha yavaş, daha pahalı)" IsChecked="{Binding UseQualityModel}" />
            <CheckBox Content="İkinci geçişte gözden geçir (reflect; maliyeti yaklaşık iki katına çıkarır)" IsChecked="{Binding Reflect}" />
            <CheckBox Content="Okuma hızını aşan satırları anlamı koruyarak kısalt" IsChecked="{Binding ShortenOverlong}" />
            <CheckBox Content="Şapkalı yazımları koru (rüzgâr, kâr, hâlâ)" IsChecked="{Binding KeepCircumflex}" />
            <!-- Free tier: slower but steady; avoids rate-limit errors and timeouts. -->
            <CheckBox Content="Ücretsiz katman (tek istek, küçük paketler, dakikadaki istek sınırına uy)" IsChecked="{Binding FreeTier}"
                      ToolTip.Tip="Ücretsiz Gemini anahtarlarında zaman aşımı ve 429 hatalarını önler; çeviri daha yavaş ama kesintisiz sürer." />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="28,0,0,0" IsVisible="{Binding FreeTier}">
              <TextBlock Text="Dakikada en fazla istek" VerticalAlignment="Center" />
              <NumericUpDown Minimum="1" Maximum="60" Value="{Binding RequestsPerMinute}" FormatString="0" Width="140" />
            </StackPanel>
            <Grid ColumnDefinitions="Auto,140" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="10">
              <TextBlock Text="İstek başına satır" VerticalAlignment="Center" />
              <NumericUpDown Grid.Column="1" Minimum="5" Maximum="60" Increment="5" Value="{Binding BatchSize}" FormatString="0" />
              <TextBlock Grid.Row="1" Text="Aynı anda istek" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="8" Value="{Binding Parallelism}" FormatString="0" />
            </Grid>
            <Border Classes="error" Margin="0,8,0,0">
              <TextBlock Text="{Binding PrivacyNote}" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Reading rules -->
      <TabItem Header="Altyazı kuralları">
        <ScrollViewer>
          <Grid ColumnDefinitions="260,140" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" Margin="0,12">
            <TextBlock Text="Satır başına en fazla karakter" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1" Minimum="10" Maximum="120" Value="{Binding MaxCharsPerLine}" FormatString="0" />
            <TextBlock Grid.Row="1" Text="En fazla satır" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="4" Value="{Binding MaxLines}" FormatString="0" />
            <TextBlock Grid.Row="2" Text="En kısa süre (sn)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="0.2" Maximum="5" Increment="0.1" Value="{Binding MinDuration}" FormatString="0.0" />
            <TextBlock Grid.Row="3" Text="En uzun süre (sn)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="30" Increment="0.5" Value="{Binding MaxDuration}" FormatString="0.0" />
            <TextBlock Grid.Row="4" Text="Hedef okuma hızı (karakter/sn)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="4" Grid.Column="1" Minimum="5" Maximum="40" Value="{Binding TargetCps}" FormatString="0.#" />
            <TextBlock Grid.Row="5" Text="En yüksek okuma hızı (karakter/sn)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="5" Grid.Column="1" Minimum="5" Maximum="50" Value="{Binding MaxCps}" FormatString="0.#" />
            <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Classes="muted" TextWrapping="Wrap"
                       Text="Bu kurallar uyarıları, yeni transkripsiyonların satırlara bölünmesini ve LLM kısaltmasını etkiler." />
          </Grid>
        </ScrollViewer>
      </TabItem>

      <!-- API keys -->
      <TabItem Header="API anahtarları">
        <StackPanel DataContext="{Binding ApiKeys}" x:DataType="vm:ApiKeysViewModel" Spacing="12" Margin="0,12">
          <TextBlock TextWrapping="Wrap" Classes="muted">
            <Run Text="Anahtarlar yalnızca bu bilgisayarın güvenli deposunda saklanır:" />
            <Run Text="{Binding StoreName, Mode=OneWay}" FontWeight="SemiBold" />
            <Run Text=". Proje dosyalarına, ayarlara veya loglara yazılmaz." />
          </TextBlock>
          <TextBlock Text="Google Gemini" FontWeight="SemiBold" />
          <TextBlock Text="{Binding GeminiStatus}" Classes="muted" />
          <TextBox Text="{Binding GeminiKeyInput}" PasswordChar="●" PlaceholderText="Yeni Gemini API anahtarını yapıştırın" IsEnabled="{Binding IsStoreSupported}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Anahtarı kaydet" Command="{Binding SaveCommand}" />
            <Button Content="Kayıtlı anahtarı sil" Command="{Binding RemoveCommand}" IsVisible="{Binding HasStoredKey}" />
          </StackPanel>
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
