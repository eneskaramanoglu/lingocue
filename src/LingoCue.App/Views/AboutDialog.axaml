<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LingoCue.App.Views.AboutDialog"
        Title="LingoCue hakkında"
        Width="560" Height="620" MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <!-- Static text: version, license and the third-party components with their licenses. -->
  <Window.Styles>
    <Style Selector="Grid.components > TextBlock">
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Grid.components > TextBlock.name">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,3,16,3" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="20">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button DockPanel.Dock="Right" Content="Kapat" Classes="accent" IsDefault="True" IsCancel="True" Click="OnClose" MinWidth="90" />
      <Button Content="GitHub sayfası" Click="OnOpenRepository" />
    </DockPanel>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="14" Margin="0,0,0,16">
      <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource AccentBrush}">
        <PathIcon Data="{StaticResource IconLogo}" Width="28" Height="28" Foreground="{DynamicResource OnAccentBrush}" />
      </Border>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock x:Name="NameText" Text="LingoCue" FontSize="20" FontWeight="Bold" />
        <TextBlock x:Name="VersionText" Classes="muted" />
      </StackPanel>
    </StackPanel>

    <ScrollViewer>
      <StackPanel Spacing="10">
        <TextBlock TextWrapping="Wrap"
                   Text="Yapay zekâ destekli altyazı editörü: konuşmayı yazıya döker, düzeltir, çevirir ve stilli altyazıyı videoya gömer." />
        <TextBlock TextWrapping="Wrap" Classes="muted"
                   Text="MIT lisansıyla açık kaynaktır. Kaynak kodu, sürüm notları ve hata bildirimi GitHub sayfasındadır." />

        <TextBlock Text="KULLANILAN BİLEŞENLER" Classes="section" Margin="0,8,0,0" />
        <Grid Classes="components" ColumnDefinitions="Auto,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Classes="name" Text="Avalonia" />
          <TextBlock Grid.Column="1" Text="Arayüz çatısı · MIT" />
          <TextBlock Grid.Row="1" Classes="name" Text="mpv (libmpv)" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="Video önizleme · GPL-2.0-or-later (Windows paketiyle gelir; kaynak: mpv.io)" />
          <TextBlock Grid.Row="2" Classes="name" Text="libass" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="Altyazı çizimi (mpv ve FFmpeg içinde) · ISC" />
          <TextBlock Grid.Row="3" Classes="name" Text="FFmpeg" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="Ses/video işleme · LGPL/GPL (ayrıca kurulur, uygulamayla dağıtılmaz)" />
          <TextBlock Grid.Row="4" Classes="name" Text="whisper.cpp / Whisper.net" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="Yerel konuşma tanıma · MIT" />
          <TextBlock Grid.Row="5" Classes="name" Text="OpenAI Whisper modelleri" />
          <TextBlock Grid.Row="5" Grid.Column="1" Text="Konuşma tanıma modelleri · MIT (ilk kullanımda indirilir)" />
          <TextBlock Grid.Row="6" Classes="name" Text="Silero VAD" />
          <TextBlock Grid.Row="6" Grid.Column="1" Text="Konuşma algılama modeli · MIT" />
          <TextBlock Grid.Row="7" Classes="name" Text="Google Gen AI .NET SDK" />
          <TextBlock Grid.Row="7" Grid.Column="1" Text="Gemini erişimi · Apache-2.0" />
          <TextBlock Grid.Row="8" Classes="name" Text="Microsoft.Extensions.AI" />
          <TextBlock Grid.Row="8" Grid.Column="1" Text="Dil modeli arabirimi · MIT" />
          <TextBlock Grid.Row="9" Classes="name" Text="Velopack" />
          <TextBlock Grid.Row="9" Grid.Column="1" Text="Kurulum ve güncelleme · MIT" />
          <TextBlock Grid.Row="10" Classes="name" Text="CommunityToolkit.Mvvm, Serilog" />
          <TextBlock Grid.Row="10" Grid.Column="1" Text="MVVM ve günlükleme · MIT / Apache-2.0" />
          <TextBlock Grid.Row="11" Classes="name" Text="Inter, Material Design Icons" />
          <TextBlock Grid.Row="11" Grid.Column="1" Text="Yazı tipi ve simgeler · OFL-1.1 / Apache-2.0" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
